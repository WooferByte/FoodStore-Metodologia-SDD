# Application
ENV=development
APP_NAME=Food Store API
APP_VERSION=1.0.0

# Database
# Docker Compose maps host port 5433 → container 5432 (see docker-compose.yml)
# Credentials match docker-compose.yml defaults: POSTGRES_USER=postgres, POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/foodstore_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Seeding is done manually with `python scripts/seed.py` from backend/ (not automatic).
# SEED_DATABASE=true

# Security & JWT
SECRET_KEY=your-secret-key-minimum-256-bits-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_COST=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MercadoPago
MP_ACCESS_TOKEN=TEST-your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key
# URL que MercadoPago alcanza para notificar el estado del pago (webhook).
# Con un túnel público (ngrok) apuntando a localhost:8000, usá esa URL pública.
MP_NOTIFICATION_URL=http://localhost:8000/api/v1/webhooks/mercadopago
# Base del frontend para construir los back_urls de la preferencia:
#   back_urls.{success,failure,pending} = {MP_FRONTEND_URL}/checkout
# Con una URL pública se habilita auto_return="approved" automáticamente.
MP_FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_WINDOW=900
